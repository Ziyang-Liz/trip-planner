# Copy to .env only if .env does not already exist.
# The backend and Docker Compose use the same PG_* variables.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=trip_db
PG_USER=postgres
PG_PASSWORD=postgres
PG_CONNECT_TIMEOUT=5

# Required for /plan/ on a cache miss. Never put API keys in frontend env files.
OPENTRIPMAP_API_KEY=
# Optional: missing key currently produces demo weather, not real forecasts.
OPENWEATHER_API_KEY=

# Optional pgAdmin UI (Compose --profile tools).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
